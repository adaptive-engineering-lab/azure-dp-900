# Copy to .env.local. Only public (anon) keys belong here.
# The service_role key is for the seed tooling only (tools/.env.local), NEVER the frontend.

# DP-900 Supabase project — get these from your Supabase dashboard.
# New-style keys (sb_publishable_…) work here too: supabase-js passes the key
# straight through as a header and never decodes it.
VITE_SUPABASE_URL=https://<dp900-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Exam identity — used in page titles, meta tags, og:title
VITE_EXAM_CODE=DP-900
VITE_EXAM_TITLE=Microsoft Azure Data Fundamentals
VITE_CERT_TITLE=Azure Data Fundamentals

# Product-ID mode off for DP-900
VITE_ENABLE_PRODUCT_ID=false
